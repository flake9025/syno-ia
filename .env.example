# =============================================================================
# syno-ia — configuration
# Copiez ce fichier en « .env » et adaptez-le. Ne le versionnez jamais.
# Sur le NAS : /volume1/docker/apps/syno-ia/.env
# =============================================================================

# ------------------------------------------------------------------ général
PORT=8080
DATA_DIR=/app/data
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=fr

# Clé de signature des cookies de session. OBLIGATOIRE en production, sinon
# elle est régénérée à chaque redémarrage (déconnexion de tout le monde).
#   openssl rand -hex 32
APP_SECRET=

# ----------------------------------------------------------------- synology
# URL de DSM joignable depuis le conteneur.
#   - conteneur sur le NAS      : http://172.17.0.1:5000 (passerelle du bridge)
#   - DSM en HTTPS uniquement   : https://172.17.0.1:5001 + DSM_VERIFY_SSL=false
DSM_URL=http://172.17.0.1:5000
DSM_VERIFY_SSL=false
DSM_TIMEOUT=20

# Compte de service utilisé UNIQUEMENT pour l'indexation et la cartographie des
# partages. Il ne sert jamais à répondre à un utilisateur : chaque question est
# filtrée avec le sid personnel de l'utilisateur connecté.
# Créez un compte DSM dédié, en lecture seule sur les dossiers à indexer.
# Le nom ci-dessous est celui utilisé par le README : créez-le tel quel dans DSM
# et il n'y a rien à modifier ici, hormis le mot de passe.
DSM_SERVICE_ACCOUNT=syno-ia-svc
DSM_SERVICE_PASSWORD=

# Comptes DSM autorisés à administrer syno-ia, en plus des administrateurs DSM
# (détectés automatiquement). Liste séparée par des virgules.
ADMIN_ACCOUNTS=

# Durée d'une session web (minutes) et du cache des décisions d'accès (secondes).
SESSION_TTL_MINUTES=720
ACL_CACHE_TTL=300
# Durée (jours) pendant laquelle un navigateur approuvé est dispensé du code 2FA.
# Le mot de passe reste exigé à chaque connexion. 0 désactive la fonction.
DEVICE_TRUST_DAYS=30
# Vérification fichier par fichier via FileStation, en plus du filtre par
# partage. À ne passer à « false » que si aucune ACL avancée n'est utilisée.
ACL_STRICT=true

# --------------------------------------------------------------- indexation
# « mount » : les partages sont montés dans le conteneur (rapide, recommandé).
# « filestation » : lecture via l'API DSM, sans aucun montage (plus lent).
INDEX_MODE=mount

# Racines à indexer, séparées par des virgules. En mode « mount », ces chemins
# doivent être montés À L'IDENTIQUE dans le conteneur (voir docker-compose.yml).
# Par défaut, les dossiers personnels : chaque utilisateur n'y retrouve que les
# siens, ce qui fonctionne sur tout NAS sans rien avoir à adapter.
# Pour ajouter des dossiers partagés, listez-les avec « ls -1 /volume1/ » en
# respectant la casse, puis montez chacun d'eux.
INDEX_ROOTS=/volume1/homes

INDEX_EXCLUDE_GLOBS=**/@eaDir/**,**/#recycle/**,**/.*/**,**/node_modules/**,**/*.tmp
INDEX_MAX_FILE_MB=40
# Réindexation automatique (minutes ; 0 pour désactiver).
INDEX_INTERVAL_MINUTES=360
INDEX_ON_STARTUP=true
INDEX_BATCH_SIZE=32

CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---------------------------------------------------------------- recherche
# 0 = valeur déduite automatiquement du profil matériel détecté.
RETRIEVAL_CANDIDATES=0
RETRIEVAL_TOP_K=0
CONTEXT_MAX_CHARS=0

# --------------------------------------------------------------- embeddings
# auto | model2vec | fastembed | none
EMBEDDING_BACKEND=auto
# Vide = modèle choisi par le profil matériel.
# Avec fastembed, le modèle doit appartenir au catalogue ONNX officiel
# (python -c "from fastembed import TextEmbedding; print([m['model'] for m in TextEmbedding.list_supported_models()])")
EMBEDDING_MODEL=
# L'application démarre en recherche lexicale (BM25) et charge le modèle en
# arrière-plan ; les documents indexés entre-temps sont vectorisés ensuite, sans
# réindexation. Passer à false rend le démarrage bloquant : déconseillé, le
# premier téléchargement peut dépasser le délai du healthcheck Docker.
EMBEDDING_ASYNC_LOAD=true
# Fragments vectorisés par lot lors de ce rattrapage (réduire si la RAM est juste).
EMBEDDING_BACKFILL_BATCH=64

# ---------------------------------------------------------------------- LLM
# auto | llamacpp | ollama | openai | none
#   auto     : openai si clé → ollama si joignable → llamacpp si modèle présent
#              → sinon mode extractif (réponses citées, sans génération).
LLM_BACKEND=auto
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_CONTEXT_SIZE=4096
# 0 = déduit du nombre de cœurs, en en laissant toujours un au serveur web.
# Occuper tous les cœurs rend la sonde de santé muette : le NAS redémarre alors
# le conteneur en pleine réponse.
LLM_THREADS=0
# Délai maximal d'une génération (secondes). Au-delà, la réponse est arrêtée et
# ce qui a été produit est renvoyé, plutôt que de laisser la requête s'éterniser.
# 0 = sans limite.
LLM_TIMEOUT_SECONDS=120

# Ollama installé sur le NAS ou sur une autre machine du réseau.
OLLAMA_URL=http://172.17.0.1:11434

# Service compatible OpenAI (OpenAI, Groq, Mistral, LM Studio, vLLM…).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Forçage du profil matériel : auto | nano | micro | small | medium | large
HARDWARE_PROFILE=auto
